# ============================================================
# ГосДок — PRODUCTION .env (для деплоя на GCP VM)
# Скопируйте в .env на сервере и заполните РЕАЛЬНЫМИ значениями.
# ============================================================

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.production
# Сгенерируйте: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=ЗАМЕНИТЕ_на_случайную_строку_64+_символов
DJANGO_ENVIRONMENT=production

# Домен (и/или внешний IP VM) — через запятую, без http://
DJANGO_ALLOWED_HOSTS=gosdoc.duckdns.org,ВАШ_ВНЕШНИЙ_IP
DJANGO_CSRF_TRUSTED_ORIGINS=https://gosdoc.duckdns.org

# HTTPS: True если есть домен (Caddy выдаст сертификат); False для http-only по IP
DJANGO_SECURE_SSL_REDIRECT=True

# --- Caddy: адрес сайта ---
# Домен → авто-HTTPS Let's Encrypt;  :80 → http-only по IP (для быстрого теста)
SITE_ADDRESS=gosdoc.duckdns.org

# --- PostgreSQL (придумайте надёжный пароль!) ---
POSTGRES_DB=gosdoc
POSTGRES_USER=gosdoc_user
POSTGRES_PASSWORD=ЗАМЕНИТЕ_надёжный_пароль

# --- Claude AI (Anthropic) ---
CLAUDE_API_KEY=ваш_ключ_anthropic
CLAUDE_MODEL=claude-sonnet-4-6

# --- Google OAuth (тот же Client ID, что в gosdoc-frontend-new) ---
GOOGLE_CLIENT_ID=847442260876-89hfpa3r9djdh2pdqnvasj9b829ugu6p.apps.googleusercontent.com

# --- AWS S3 / Yandex Object Storage (для загрузки документов) ---
AWS_ACCESS_KEY_ID=ваш-access-key
AWS_SECRET_ACCESS_KEY=ваш-secret-key
AWS_STORAGE_BUCKET_NAME=gosdoc-documents
AWS_S3_REGION_NAME=us-east-1
# AWS_S3_ENDPOINT_URL=https://storage.yandexcloud.net   # только для Yandex

# --- Email (SMTP, Gmail app password) ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=ваш-gmail@gmail.com
EMAIL_HOST_PASSWORD=app-password
DEFAULT_FROM_EMAIL=ГосДок <ваш-gmail@gmail.com>

# --- MeiliSearch ---
MEILISEARCH_KEY=ЗАМЕНИТЕ_длинный_ключ

# --- JWT ---
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# --- Sentry (опционально) ---
SENTRY_DSN=
